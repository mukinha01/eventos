generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Evento {
  id          Int                  @id @default(autoincrement())
  nome        String               @db.VarChar(150)
  descricao   String
  local       String               @db.VarChar(200)
  palestrantes EventoPalestrante[]

  @@map("eventos")
}

model Palestrante {
  id      Int                  @id @default(autoincrement())
  nome    String               @db.VarChar(150)
  email   String               @unique @db.VarChar(200)
  eventos EventoPalestrante[]

  @@map("palestrantes")
}

model EventoPalestrante {
  eventoId      Int @map("evento_id")
  palestranteId Int @map("palestrante_id")

  evento      Evento      @relation(fields: [eventoId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  palestrante Palestrante @relation(fields: [palestranteId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([eventoId, palestranteId])
  @@map("evento_palestrantes")
}
